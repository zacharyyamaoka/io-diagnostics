# RobotDx device reset access (docs/device-reset.md "Permissions"): lets the plugdev group run every USB rung of a reset
# ladder WITHOUT root at runtime, for these device classes only. Generated by `python -m io_diagnostics.recovery udev-rules`
# from io_diagnostics/recovery/profiles/; installed by tools/install_device_reset_access.sh (run it once with sudo).
#
# Per device class, three grants, all scoped to the device (never every USB device: a keyboard's node stays root's):
#   1. its usbfs node /dev/bus/usb/BBB/DDD to plugdev 0664, for USBDEVFS_RESET (usbreset, fdcanusb-reset)
#   2. its sysfs `authorized` switch to plugdev g+w, for the kernel deauthorize / reauthorize rung
#   3. the `disable` switch of the hub port it is plugged into (and that port's USB 3 peer) to plugdev g+w, for the port
#      power cycle; on a hub without per-port power switching it is only a logical disconnect, and the ladder skips it
# WHY RUN chgrp/chmod for 2 and 3: a sysfs attribute is not a device node, so GROUP= / MODE= cannot reach it (the pattern
# uhubctl's README uses for */disable). $$f is a literal $f for the shell; $sys$devpath is udev's.
#
# Undo: sudo rm /etc/udev/rules.d/70-robotdx-device-reset.rules && sudo udevadm control --reload

# mjbots fdcanusb (CAN-FD adapter)
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{manufacturer}=="mjbots", ATTR{product}=="fdcanusb", GROUP="plugdev", MODE="0664", RUN+="/bin/sh -c 'chgrp plugdev $sys$devpath/authorized && chmod g+w $sys$devpath/authorized; for f in $sys$devpath/port/disable $sys$devpath/port/peer/disable; do [ -e $$f ] && chgrp plugdev $$f && chmod g+w $$f; done; true'"

# Intel RealSense depth camera
# its node: left alone, librealsense's own rule (60-librealsense2-udev-rules.rules) already gives plugdev 0666 on its USB node
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="8086", ATTR{idProduct}=="0b*", RUN+="/bin/sh -c 'chgrp plugdev $sys$devpath/authorized && chmod g+w $sys$devpath/authorized; for f in $sys$devpath/port/disable $sys$devpath/port/peer/disable; do [ -e $$f ] && chgrp plugdev $$f && chmod g+w $$f; done; true'"

# OBSBOT PTZ webcam (UVC)
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3564", GROUP="plugdev", MODE="0664", RUN+="/bin/sh -c 'chgrp plugdev $sys$devpath/authorized && chmod g+w $sys$devpath/authorized; for f in $sys$devpath/port/disable $sys$devpath/port/peer/disable; do [ -e $$f ] && chgrp plugdev $$f && chmod g+w $$f; done; true'"
